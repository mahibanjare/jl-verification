function doGet() {
  return json_({ success: true, app: 'JL FI/CPV backend', time: new Date().toISOString() });
}

function doPost(e) {
  let body;
  try { body = JSON.parse(e.postData.contents); } catch (err) { return json_({ success: false, error: 'Bad request' }); }
  try {
    if (!checkToken_(body.token)) return json_({ success: false, error: 'Unauthorized' });
    if (body.action === 'login') return json_(Object.assign({ success: true }, withLock_(() => login_(body))));

    const user = auth_(body.session);
    if (!user) return json_({ success: false, error: 'SESSION_EXPIRED' });
    const a = ACTIONS[body.action];
    if (!a) return json_({ success: false, error: 'Unknown action: ' + body.action });
    if (a.roles.indexOf(user.role) < 0) return json_({ success: false, error: 'You do not have permission for this action' });

    const res = (a.write ? withLock_(() => a.run(body, user)) : a.run(body, user)) || {};
    const after = res._after;
    delete res._after;
    if (after) { try { after(); } catch (err) { audit_('', user.userId, 'NOTIFY_ERROR', String(err)); } }
    return json_(Object.assign({ success: true }, res));
  } catch (err) {
    return json_({ success: false, error: String(err && err.message ? err.message : err) });
  }
}

// ============================ AUTH ====================================
function login_(b) {
  const uid = String(b.userId || '').trim();
  const cache = CacheService.getScriptCache();
  const failKey = 'F:' + uid.toLowerCase();
  const fails = Number(cache.get(failKey) || 0);
  if (fails >= 5) throw new Error('Too many failed attempts. Try again in 15 minutes.');
  const t = table_('Login');
  const r = findUserRow_(t, uid);
  if (!r || !verifyPassword_(String(r['Password']), String(b.password || ''))) {
    cache.put(failKey, String(fails + 1), 900);
    throw new Error('Invalid credentials');
  }
  if (!isActive_(r)) throw new Error('Your account is inactive. Contact the admin.');
  cache.remove(failKey);
  if (String(r['Password']).indexOf('sha256:') !== 0) writeRow_(t, r, { Password: hashPassword_(String(b.password)) }); // upgrade legacy plaintext
  const session = Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, '');
  cache.put('S:' + session, String(r['User ID']), SESSION_TTL);
  audit_('', r['User ID'], 'LOGIN', '');
  return { user: publicUser_(r), session: session };
}

function auth_(session) {
  if (!session) return null;
  const cache = CacheService.getScriptCache();
  const uid = cache.get('S:' + session);
  if (!uid) return null;
  const r = findUserRow_(table_('Login'), uid);
  if (!r || !isActive_(r)) { cache.remove('S:' + session); return null; }
  cache.put('S:' + session, uid, SESSION_TTL); // sliding expiry
  const u = publicUser_(r);
  u.session = session;
  return u;
}

function changePassword_(b, u) {
  const t = table_('Login');
  const r = findUserRow_(t, u.userId);
  if (!verifyPassword_(String(r['Password']), String(b.oldPassword || ''))) throw new Error('Current password is wrong');
  if (String(b.newPassword || '').length < 6) throw new Error('New password must be at least 6 characters');
  writeRow_(t, r, { Password: hashPassword_(String(b.newPassword)) });
  audit_('', u.userId, 'CHANGE_PASSWORD', '');
  return {};
}

function updateMyContact_(b, u) {
  const t = table_('Login');
  const r = findUserRow_(t, u.userId);
  const rec = b.record || {};
  const email = String(rec.email || '').trim();
  if (email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) throw new Error('Invalid email');
  writeRow_(t, r, { Email: email, 'Contact No': String(rec.phone || '').trim() });
  return { user: publicUser_(findUserRow_(table_('Login'), u.userId)) };
}

// ============================ USERS ===================================
function normRole_(r) {
  r = String(r || '').toUpperCase().replace(/[\s-]+/g, '_');
  if (r === 'USER' || r === 'FIELD' || r === 'EXECUTIVE' || r === 'FIELD_EXECUTIVE') return 'FIELD_EXEC';
  if (r === 'OFFICE') return 'REVIEWER';
  return ROLES.indexOf(r) >= 0 ? r : 'FIELD_EXEC';
}
function isActive_(r) {
  const a = String(r['Active'] === undefined ? 'Yes' : r['Active']).trim().toLowerCase();
  return a !== 'no' && a !== 'false' && a !== '0' && a !== 'inactive';
}
function findUserRow_(t, uid) {
  const k = String(uid || '').trim().toLowerCase();
  return t.rows.filter((r) => String(r['User ID']).trim().toLowerCase() === k)[0] || null;
}
function publicUser_(r) {
  return {
    userId: String(r['User ID']), name: String(r['Full Name'] || r['User ID']), role: normRole_(r['Role']),
    email: String(r['Email'] || ''), phone: String(r['Contact No'] || ''), designation: String(r['Designation'] || ''),
    telegramLinked: !!String(r['Telegram Chat ID'] || '').trim(),
  };
}

function listUsers_() {
  return {
    rows: table_('Login').rows.map((r) => Object.assign(publicUser_(r), {
      active: isActive_(r), telegramChatId: String(r['Telegram Chat ID'] || ''),
    })),
  };
}

function listExecutives_() {
  return {
    rows: table_('Login').rows
      .filter((r) => isActive_(r) && normRole_(r['Role']) === 'FIELD_EXEC')
      .map((r) => ({ userId: String(r['User ID']), name: String(r['Full Name'] || r['User ID']) })),
  };
}

function activeAdmins_(t, exceptUid) {
  return t.rows.filter((r) => normRole_(r['Role']) === 'ADMIN' && isActive_(r)
    && String(r['User ID']).toLowerCase() !== String(exceptUid || '').toLowerCase()).length;
}

function saveUser_(b, u) {
  const rec = b.record || {};
  const uid = String(rec.userId || '').trim();
  if (!/^[A-Za-z0-9._@-]{3,40}$/.test(uid)) throw new Error('User ID must be 3–40 characters: letters, numbers, . _ - @');
  if (!String(rec.name || '').trim()) throw new Error('Full name is required');
  const role = normRole_(rec.role);
  const t = table_('Login');
  const existing = findUserRow_(t, uid);
  const obj = {
    'Full Name': String(rec.name).trim(), 'Contact No': String(rec.phone || '').trim(), Email: String(rec.email || '').trim(),
    Designation: String(rec.designation || '').trim(), Role: role, Active: rec.active === false ? 'No' : 'Yes',
    'Telegram Chat ID': String(rec.telegramChatId || '').trim(),
  };
  if (b.isNew) {
    if (existing) throw new Error('User ID already exists');
    if (String(rec.password || '').length < 6) throw new Error('Password must be at least 6 characters');
    obj['User ID'] = uid;
    obj.Password = hashPassword_(String(rec.password));
    obj.Timestamp = nowText_();
    obj['Serial No'] = t.rows.length + 1;
    append_('Login', obj);
    audit_('', u.userId, 'CREATE_USER', uid + ' (' + role + ')');
  } else {
    if (!existing) throw new Error('User not found');
    const self = uid.toLowerCase() === u.userId.toLowerCase();
    if (self && (role !== 'ADMIN' || obj.Active === 'No')) throw new Error("You can't remove your own admin access");
    if (normRole_(existing['Role']) === 'ADMIN' && (role !== 'ADMIN' || obj.Active === 'No') && activeAdmins_(t, uid) === 0) throw new Error('At least one active admin is required');
    if (String(rec.password || '').trim()) {
      if (String(rec.password).length < 6) throw new Error('Password must be at least 6 characters');
      obj.Password = hashPassword_(String(rec.password));
    }
    writeRow_(t, existing, obj);
    audit_('', u.userId, 'UPDATE_USER', uid + ' (' + role + ', ' + (obj.Active === 'No' ? 'inactive' : 'active') + (obj.Password ? ', password reset' : '') + ')');
  }
  return {};
}

function deleteUser_(b, u) {
  const t = table_('Login');
  const r = findUserRow_(t, b.userId);
  if (!r) throw new Error('User not found');
  if (String(r['User ID']).toLowerCase() === u.userId.toLowerCase()) throw new Error("You can't delete your own account");
  if (normRole_(r['Role']) === 'ADMIN' && activeAdmins_(t, r['User ID']) === 0) throw new Error('At least one active admin is required');
  t.sh.deleteRow(r._row);
  audit_('', u.userId, 'DELETE_USER', String(r['User ID']));
  return {};
}

// ============================ MASTERS =================================
function masterCfg_(sheet) {
  const cfg = MASTERS[sheet];
  if (!cfg) throw new Error('Not a master sheet: ' + sheet);
  return cfg;
}
function listMaster_(b) {
  masterCfg_(b.sheet);
  return { rows: table_(b.sheet).rows.map(strip_) };
}
function saveMaster_(b, u) {
  const cfg = masterCfg_(b.sheet);
  const t = table_(b.sheet);
  const rec = {};
  t.headers.forEach((h) => { if (h !== 'Timestamp' && h !== cfg.idColumn && b.record && b.record[h] !== undefined) rec[h] = String(b.record[h]).trim(); });
  if (!rec[cfg.nameCol]) throw new Error(cfg.nameCol + ' is required');
  const norm = (s) => String(s || '').trim().toLowerCase();
  if (!b.matchValue) {
    // Adding from the allocation form: never create the same client twice,
    // or the same branch twice under one client — reuse the existing row.
    const dup = t.rows.filter((x) => norm(x[cfg.nameCol]) === norm(rec[cfg.nameCol])
      && (b.sheet !== 'Branches' || norm(x.Client) === norm(rec.Client)))[0];
    if (dup) return { id: String(dup[cfg.idColumn]), existed: true };
  }
  if (b.matchValue) {
    if (u.role !== 'ADMIN') throw new Error('Only an admin can edit ' + b.sheet);
    const r = t.rows.filter((x) => String(x[cfg.idColumn]) === String(b.matchValue))[0];
    if (!r) throw new Error('Record not found');
    writeRow_(t, r, rec);
    audit_('', u.userId, 'UPDATE_' + b.sheet.toUpperCase(), String(b.matchValue));
  } else {
    rec.Timestamp = nowText_();
    rec[cfg.idColumn] = nextId_(t.rows.map((x) => x[cfg.idColumn]), cfg.prefix);
    append_(b.sheet, rec);
    audit_('', u.userId, 'CREATE_' + b.sheet.toUpperCase(), rec[cfg.idColumn] + ' ' + rec[cfg.nameCol]);
    return { id: rec[cfg.idColumn] };
  }
  return {};
}
function deleteMaster_(b, u) {
  const cfg = masterCfg_(b.sheet);
  const t = table_(b.sheet);
  const r = t.rows.filter((x) => String(x[cfg.idColumn]) === String(b.matchValue))[0];
  if (!r) throw new Error('Record not found');
  t.sh.deleteRow(r._row);
  audit_('', u.userId, 'DELETE_' + b.sheet.toUpperCase(), String(b.matchValue));
  return {};
}

// ============================ CASES ===================================
function canAccess_(u, c) {
  return u.role !== 'FIELD_EXEC' || String(c['Assigned To']).trim().toLowerCase() === u.userId.toLowerCase();
}

// Reads only the light (non-JSON) columns — fast even with many cases.
function casesLite_() {
  const sh = sheet_('Cases');
  const headers = headers_(sh);
  const last = sh.getLastRow();
  if (last < 2) return [];
  const liteIdx = headers.map((h, i) => (JSON_COLS[h] ? -1 : i)).filter((i) => i >= 0);
  const width = Math.max.apply(null, liteIdx) + 1;
  const values = sh.getRange(2, 1, last - 1, width).getValues();
  const out = [];
  values.forEach((row) => {
    if (!row[headers.indexOf('Case No')]) return;
    const o = {};
    liteIdx.forEach((i) => { o[headers[i]] = cell_(row[i]); });
    out.push(o);
  });
  return out;
}

function findCase_(caseNo) {
  const sh = sheet_('Cases');
  const headers = headers_(sh);
  const col = headers.indexOf('Case No') + 1;
  const last = sh.getLastRow();
  if (!caseNo || last < 2) return null;
  const hit = sh.getRange(2, col, last - 1, 1).createTextFinder(String(caseNo)).matchEntireCell(true).findNext();
  if (!hit) return null;
  const rowNum = hit.getRow();
  const vals = sh.getRange(rowNum, 1, 1, headers.length).getValues()[0];
  const row = { _row: rowNum };
  headers.forEach((h, i) => { row[h] = cell_(vals[i]); });
  return { t: { sh: sh, headers: headers }, row: row };
}

function loadCase_(caseNo, u) {
  const f = findCase_(caseNo);
  if (!f) throw new Error('Case not found: ' + caseNo);
  if (!canAccess_(u, f.row)) throw new Error('This case is not assigned to you');
  return f;
}

function parseJson_(s, fallback) {
  if (s === '' || s === null || s === undefined) return fallback;
  try { return JSON.parse(s); } catch (e) { return fallback; }
}

function caseOut_(row) {
  const o = strip_(row);
  o.data = {};
  Object.keys(JSON_COLS).forEach((col) => {
    const key = JSON_COLS[col];
    delete o[col];
    const v = parseJson_(row[col], undefined);
    if (key === 'photos') o.photos = v || [];
    else if (key === 'comments') o.comments = v || {};
    else if (v !== undefined) o.data[key] = v;
  });
  return o;
}

function requiredKeys_(c) {
  return String(c['Verifications Required'] || '').split(',')
    .map((s) => VERIF_KEYS[s.trim().toLowerCase()]).filter(Boolean);
}

function listCases_(b, u) {
  let rows = casesLite_();
  if (u.role === 'FIELD_EXEC') rows = rows.filter((c) => canAccess_(u, c));
  return { rows: rows };
}

function getCase_(b, u) {
  return { case: caseOut_(loadCase_(b.caseNo, u).row) };
}

const PRODUCTS = ['Home Loan', 'Vehicle Loan'];
const ACTIVITIES = ['FI', 'CPV'];
const OCCUPATIONS = ['Salaried', 'Self Employed', 'Professional'];
function pick_(v, list, label) {
  const s = String(v || '').trim().toLowerCase().replace(/[_-]/g, ' ');
  const hit = list.filter((x) => x.toLowerCase() === s)[0];
  if (!hit) throw new Error(label + ' must be one of: ' + list.join(', '));
  return hit;
}

function normaliseMeta_(rec, execs) {
  const out = {};
  ['Client', 'Branch', 'Applicant Name', 'Applicant Mobile', 'Applicant Address', 'Business Name'].forEach((k) => {
    if (rec[k] !== undefined) out[k] = String(rec[k]).trim();
  });
  if (rec.Product !== undefined) out.Product = pick_(rec.Product, PRODUCTS, 'Product');
  if (rec.Activity !== undefined) out.Activity = pick_(rec.Activity, ACTIVITIES, 'Activity');
  if (rec.Occupation !== undefined) out.Occupation = pick_(rec.Occupation, OCCUPATIONS, 'Occupation');
  if (rec['Verifications Required'] !== undefined) {
    const labels = { residence: 'Residence', employment: 'Employment', business: 'Business', bank: 'Bank', itr: 'ITR', 'other docs': 'Other Docs', otherdocs: 'Other Docs' };
    const v = String(rec['Verifications Required']).split(/[,;|]/).map((s) => labels[s.trim().toLowerCase()]).filter(Boolean);
    if (!v.length) throw new Error('Verifications Required must list at least one of: Residence, Employment, Business, Bank, ITR, Other Docs');
    out['Verifications Required'] = v.filter((x, i) => v.indexOf(x) === i).join(', ');
  }
  if (rec['Assigned To'] !== undefined) {
    const ex = execs.filter((x) => x.userId.toLowerCase() === String(rec['Assigned To']).trim().toLowerCase())[0];
    if (!ex) throw new Error('Assigned To "' + rec['Assigned To'] + '" is not an active field executive');
    out['Assigned To'] = ex.userId;
    out['Executive Name'] = ex.name;
  }
  return out;
}

function createCases_(b, u) {
  const records = b.records || [];
  if (!records.length) throw new Error('Nothing to create');
  if (records.length > 300) throw new Error('Max 300 cases per upload');
  const execs = listExecutives_().rows;
  const prepared = records.map((rec, i) => {
    try {
      const m = normaliseMeta_(rec, execs);
      ['Client', 'Applicant Name', 'Applicant Mobile', 'Applicant Address', 'Product', 'Activity', 'Verifications Required', 'Assigned To'].forEach((k) => {
        if (!m[k]) throw new Error(k + ' is required');
      });
      if (!/^\d{10}$/.test(m['Applicant Mobile'])) throw new Error('Applicant Mobile must be 10 digits');
      if (!m.Occupation) m.Occupation = 'Salaried';
      return m;
    } catch (err) {
      throw new Error((records.length > 1 ? 'Row ' + (i + 1) + ': ' : '') + err.message);
    }
  });
  const sh = sheet_('Cases');
  const headers = headers_(sh);
  const nos = nextCaseNos_(sh, headers, prepared.length);
  const now = new Date().toISOString();
  const rows = prepared.map((m, i) => rowArray_(headers, Object.assign(m, {
    Timestamp: nowText_(), 'Case No': nos[i], Status: 'ALLOCATED', 'Allocated At': now,
    'Report Version': 0, 'Photo Count': 0, 'Updated At': now, 'Updated By': u.userId,
  })));
  sh.getRange(sh.getLastRow() + 1, 1, rows.length, headers.length).setNumberFormat('@').setValues(rows);
  nos.forEach((no, i) => audit_(no, u.userId, 'ALLOCATE', prepared[i]['Applicant Name'] + ' → ' + prepared[i]['Assigned To']));
  return { created: nos };
}

// Case numbers are never reused, even after a case is deleted: the highest
// number ever issued is kept in Script Properties (per year). Called under
// the script lock (createCases is a write action).
function nextCaseNos_(sh, headers, count) {
  const year = Utilities.formatDate(new Date(), TZ, 'yyyy');
  const prefix = CASE_PREFIX + '-' + year + '-';
  const props = PropertiesService.getScriptProperties();
  const key = 'CASE_SEQ_' + year;
  const numOf = (v) => {
    const s = String(v || '');
    return s.indexOf(prefix) === 0 ? (parseInt(s.slice(prefix.length), 10) || 0) : 0;
  };
  const maxIn = (sheet, colName) => {
    if (!sheet || sheet.getLastRow() < 2) return 0;
    const col = headers_(sheet).indexOf(colName) + 1;
    if (col < 1) return 0;
    return sheet.getRange(2, col, sheet.getLastRow() - 1, 1).getValues()
      .reduce((m, r) => Math.max(m, numOf(r[0])), 0);
  };
  let max = Math.max(Number(props.getProperty(key)) || 0, maxIn(sh, 'Case No'));
  // First run with the counter: also count numbers that only survive in the
  // Audit / Reports history (cases deleted before this counter existed).
  if (!props.getProperty(key)) {
    const ss = ss_();
    max = Math.max(max, maxIn(ss.getSheetByName('Audit'), 'Case No'), maxIn(ss.getSheetByName('Reports'), 'Case No'));
  }
  const out = [];
  for (let i = 1; i <= count; i++) out.push(prefix + ('000000' + (max + i)).slice(-6));
  props.setProperty(key, String(max + count));
  return out;
}

function updateCaseMeta_(b, u) {
  const f = loadCase_(b.caseNo, u);
  if (f.row.Status === 'REPORT_SENT') throw new Error('Report already sent — case is locked');
  const m = normaliseMeta_(b.record || {}, listExecutives_().rows);
  writeRow_(f.t, f.row, Object.assign(m, touch_(u)));
  audit_(b.caseNo, u.userId, 'EDIT_ALLOCATION', Object.keys(m).join(', '));
  return {};
}

function deleteCase_(b, u) {
  const f = loadCase_(b.caseNo, u);
  parseJson_(f.row.Photos, []).forEach((p) => { try { DriveApp.getFileById(p.id).setTrashed(true); } catch (e) { /* already gone */ } });
  f.t.sh.deleteRow(f.row._row);
  audit_(b.caseNo, u.userId, 'DELETE_CASE', String(f.row['Applicant Name']));
  return {};
}

const FE_EDITABLE = ['ALLOCATED', 'IN_FIELD', 'SENT_BACK'];

function sectionPatch_(row, data) {
  const allowed = ['visit'].concat(requiredKeys_(row));
  const patch = {};
  Object.keys(data || {}).forEach((k) => {
    if (allowed.indexOf(k) >= 0 && SECTION_COLS[k]) {
      const s = JSON.stringify(data[k]);
      if (s.length > 45000) throw new Error('Section "' + k + '" is too large');
      patch[SECTION_COLS[k]] = s;
    }
  });
  return patch;
}

function saveSections_(b, u) {
  const f = loadCase_(b.caseNo, u);
  const st = f.row.Status;
  const patch = sectionPatch_(f.row, b.data);
  if (u.role === 'FIELD_EXEC') {
    if (FE_EDITABLE.indexOf(st) < 0) throw new Error('Case is ' + st + ' — it can no longer be edited from the field');
    patch.Status = st === 'SENT_BACK' ? 'SENT_BACK' : 'IN_FIELD';
    if (!f.row['Started At']) patch['Started At'] = new Date().toISOString();
  } else {
    if (st === 'REPORT_SENT') throw new Error('Report already sent — case is locked');
    if (st === 'SUBMITTED' || st === 'APPROVED') patch.Status = 'UNDER_REVIEW';
  }
  writeRow_(f.t, f.row, Object.assign(patch, touch_(u)));
  audit_(b.caseNo, u.userId, 'SAVE_SECTIONS', Object.keys(patch).filter((k) => JSON_COLS[k]).join(', '));
  return { status: patch.Status || st };
}

function submitCase_(b, u) {
  const f = loadCase_(b.caseNo, u);
  if (FE_EDITABLE.indexOf(f.row.Status) < 0) throw new Error('Case is already ' + f.row.Status);
  const patch = sectionPatch_(f.row, b.data);
  // Server-side checks (the app runs the full rule set before this).
  const req = requiredKeys_(f.row);
  const data = Object.assign({}, b.data || {});
  ['visit'].concat(req).forEach((k) => {
    const v = data[k];
    const empty = !v || (Array.isArray(v) ? !v.length : !Object.keys(v).length);
    if (empty) throw new Error('Section "' + (SECTION_COLS[k] || k) + '" is not filled');
  });
  const r = data.residence;
  if (r && r.ownership === 'Rented' && !r.monthlyRent) throw new Error('Monthly rent is required when ownership is Rented');
  if (r && Number(r.earningMembers) > Number(r.familyMembers)) throw new Error('Earning members cannot exceed family members');
  const photos = parseJson_(f.row.Photos, []);
  PHOTO_SECTIONS.filter((k) => req.indexOf(k) >= 0).forEach((k) => {
    if (!photos.some((p) => p.section === k && p.lat !== '' && p.lat !== null && p.lat !== undefined)) throw new Error('At least one GPS photo is required for ' + k);
  });
  const now = new Date().toISOString();
  Object.assign(patch, { Status: 'SUBMITTED', 'Submitted At': now }, touch_(u));
  if (!f.row['Started At']) patch['Started At'] = now;
  writeRow_(f.t, f.row, patch);
  audit_(b.caseNo, u.userId, 'SUBMIT', '');
  const c = Object.assign({}, f.row, patch);
  return { _after: () => notifySubmitted_(c) };
}

function saveComments_(b, u) {
  const f = loadCase_(b.caseNo, u);
  if (f.row.Status === 'REPORT_SENT') throw new Error('Report already sent — case is locked');
  writeRow_(f.t, f.row, Object.assign({ Comments: JSON.stringify(b.comments || {}) }, touch_(u)));
  return {};
}

function approveCase_(b, u) {
  const f = loadCase_(b.caseNo, u);
  if (['SUBMITTED', 'UNDER_REVIEW'].indexOf(f.row.Status) < 0) throw new Error('Only submitted cases can be approved (current: ' + f.row.Status + ')');
  const patch = { Status: 'APPROVED', 'Reported At': new Date().toISOString(), 'Reviewer Note': '' };
  if (b.comments) patch.Comments = JSON.stringify(b.comments);
  writeRow_(f.t, f.row, Object.assign(patch, touch_(u)));
  audit_(b.caseNo, u.userId, 'APPROVE', '');
  return {};
}

function sendBack_(b, u) {
  const f = loadCase_(b.caseNo, u);
  if (['SUBMITTED', 'UNDER_REVIEW', 'APPROVED'].indexOf(f.row.Status) < 0) throw new Error('Case cannot be sent back from ' + f.row.Status);
  const note = String(b.note || '').trim();
  if (!note) throw new Error('A note is required');
  writeRow_(f.t, f.row, Object.assign({ Status: 'SENT_BACK', 'Reviewer Note': note, 'Reported At': '' }, touch_(u)));
  audit_(b.caseNo, u.userId, 'SEND_BACK', note);
  return {};
}

function markSent_(b, u) {
  const f = loadCase_(b.caseNo, u);
  if (f.row.Status !== 'APPROVED') throw new Error('Only approved cases can be marked as sent');
  writeRow_(f.t, f.row, Object.assign({ Status: 'REPORT_SENT', 'Sent At': new Date().toISOString() }, touch_(u)));
  audit_(b.caseNo, u.userId, 'REPORT_SENT', '');
  return {};
}

function recordReport_(b, u) {
  const f = loadCase_(b.caseNo, u);
  if (['APPROVED', 'REPORT_SENT'].indexOf(f.row.Status) < 0) throw new Error('Approve the case before generating the report');
  const v = (Number(f.row['Report Version']) || 0) + 1;
  writeRow_(f.t, f.row, { 'Report Version': v });
  append_('Reports', { Timestamp: nowText_(), 'Case No': b.caseNo, Version: v, 'Generated By': u.userId, 'File Name': String(b.fileName || '') });
  audit_(b.caseNo, u.userId, 'GENERATE_REPORT', 'v' + v);
  return { version: v };
}

function touch_(u) {
  return { 'Updated At': new Date().toISOString(), 'Updated By': u.userId };
}

// ============================ PHOTOS / FILES ==========================
function folder_(name, parent) {
  const it = parent ? parent.getFoldersByName(name) : DriveApp.getFoldersByName(name);
  return it.hasNext() ? it.next() : (parent ? parent.createFolder(name) : DriveApp.createFolder(name));
}

function blobFromDataUrl_(dataUrl, name) {
  const s = String(dataUrl || '');
  const m = s.match(/^data:([^;]+);base64,(.+)$/);
  if (!m) throw new Error('Invalid image data');
  if (m[2].length > 2 * 1024 * 1024) throw new Error('Image too large (max ~1.5 MB)');
  return Utilities.newBlob(Utilities.base64Decode(m[2]), m[1], name);
}

function uploadPhoto_(b, u) {
  const f0 = loadCase_(b.caseNo, u);
  if (u.role === 'FIELD_EXEC' && FE_EDITABLE.indexOf(f0.row.Status) < 0) throw new Error('Case is already submitted');
  if (f0.row.Status === 'REPORT_SENT') throw new Error('Report already sent — case is locked');
  const lat = Number(b.lat); const lng = Number(b.lng);
  if (!isFinite(lat) || !isFinite(lng) || (lat === 0 && lng === 0)) throw new Error('GPS location is required for every photo');
  const section = ['residence', 'employment', 'business', 'other'].indexOf(b.section) >= 0 ? b.section : 'other';
  const name = b.caseNo + '_' + section + '_' + Utilities.formatDate(new Date(), TZ, 'yyyyMMdd_HHmmss') + '.jpg';
  const file = folder_(String(b.caseNo), folder_(PHOTO_FOLDER)).createFile(blobFromDataUrl_(b.dataUrl, name)); // private
  const photo = {
    id: file.getId(), section: section, lat: lat, lng: lng, accuracy: Number(b.accuracy) || null,
    capturedAt: String(b.capturedAt || new Date().toISOString()), uploadedAt: new Date().toISOString(),
    caption: String(b.caption || '').slice(0, 120), by: u.userId,
  };
  return withLock_(() => {
    const f = findCase_(b.caseNo);
    const list = parseJson_(f.row.Photos, []);
    list.push(photo);
    const patch = { Photos: JSON.stringify(list), 'Photo Count': list.length };
    if (u.role === 'FIELD_EXEC' && f.row.Status === 'ALLOCATED') patch.Status = 'IN_FIELD';
    if (!f.row['Started At']) patch['Started At'] = new Date().toISOString();
    writeRow_(f.t, f.row, Object.assign(patch, touch_(u)));
    audit_(b.caseNo, u.userId, 'PHOTO', section + ' @ ' + lat.toFixed(5) + ',' + lng.toFixed(5));
    return { photo: photo };
  });
}

function deletePhoto_(b, u) {
  const f = loadCase_(b.caseNo, u);
  if (u.role === 'FIELD_EXEC' && FE_EDITABLE.indexOf(f.row.Status) < 0) throw new Error('Case is already submitted');
  if (u.role === 'REVIEWER') throw new Error('Only an admin or the field executive can delete photos');
  const list = parseJson_(f.row.Photos, []);
  const keep = list.filter((p) => p.id !== b.photoId);
  if (keep.length === list.length) throw new Error('Photo not found');
  try { DriveApp.getFileById(b.photoId).setTrashed(true); } catch (e) { /* ignore */ }
  writeRow_(f.t, f.row, Object.assign({ Photos: JSON.stringify(keep), 'Photo Count': keep.length }, touch_(u)));
  audit_(b.caseNo, u.userId, 'DELETE_PHOTO', b.photoId);
  return {};
}

function getFile_(b, u) {
  const id = String(b.fileId || '');
  if (!id) throw new Error('fileId required');
  let ok = false;
  if (b.caseNo) {
    const f = loadCase_(b.caseNo, u);
    ok = parseJson_(f.row.Photos, []).some((p) => p.id === id);
  } else {
    const s = settings_();
    ok = STAFF.indexOf(u.role) >= 0 && (id === s.stampFileId || id === s.signatureFileId);
  }
  if (!ok) throw new Error('File not available');
  const blob = DriveApp.getFileById(id).getBlob();
  return { dataUrl: 'data:' + blob.getContentType() + ';base64,' + Utilities.base64Encode(blob.getBytes()) };
}

function uploadAsset_(b, u) {
  if (['stamp', 'signature'].indexOf(b.kind) < 0) throw new Error('Unknown asset');
  const file = folder_(ASSET_FOLDER).createFile(blobFromDataUrl_(b.dataUrl, b.kind + '_' + Date.now() + '.png'));
  const key = b.kind === 'stamp' ? 'stampFileId' : 'signatureFileId';
  const old = settings_()[key];
  withLock_(() => setSetting_(key, file.getId()));
  if (old) { try { DriveApp.getFileById(old).setTrashed(true); } catch (e) { /* ignore */ } }
  audit_('', u.userId, 'UPLOAD_' + b.kind.toUpperCase(), '');
  return { fileId: file.getId() };
}

// ============================ SETTINGS ================================
function settings_() {
  const out = Object.assign({}, DEFAULT_SETTINGS);
  const sh = ss_().getSheetByName('Settings');
  if (sh && sh.getLastRow() >= 2) {
    sh.getRange(2, 1, sh.getLastRow() - 1, 2).getValues().forEach((r) => {
      if (r[0] && Object.prototype.hasOwnProperty.call(DEFAULT_SETTINGS, r[0])) out[r[0]] = String(r[1]);
    });
  }
  return out;
}

function setSetting_(key, value) {
  const sh = sheet_('Settings');
  const last = sh.getLastRow();
  if (last >= 2) {
    const keys = sh.getRange(2, 1, last - 1, 1).getValues();
    for (let i = 0; i < keys.length; i++) {
      if (keys[i][0] === key) { sh.getRange(i + 2, 2).setValue(String(value)); return; }
    }
  }
  sh.appendRow([key, String(value)]);
}

function botToken_() { return PropertiesService.getScriptProperties().getProperty('TELEGRAM_BOT_TOKEN') || ''; }

function getSettings_(b, u) {
  const s = settings_();
  if (u.role !== 'ADMIN') {
    const pub = {};
    PUBLIC_SETTINGS.forEach((k) => { pub[k] = s[k]; });
    return { settings: pub };
  }
  const token = botToken_();
  let botUsername = '';
  if (token) { try { botUsername = botInfo_().username; } catch (e) { botUsername = ''; } }
  return {
    settings: s,
    meta: {
      telegramBotSet: !!token, botUsername: botUsername,
      emailQuota: MailApp.getRemainingDailyQuota(),
      triggerInstalled: ScriptApp.getProjectTriggers().some((t) => t.getHandlerFunction() === 'dailyOverdueAlert'),
    },
  };
}

function saveSettings_(b, u) {
  const incoming = b.settings || {};
  Object.keys(DEFAULT_SETTINGS).forEach((k) => {
    if (k === 'stampFileId' || k === 'signatureFileId') return; // set via uploadAsset
    if (incoming[k] !== undefined) setSetting_(k, String(incoming[k]).trim());
  });
  const tat = Number(incoming.tatHours);
  if (incoming.tatHours !== undefined && (!isFinite(tat) || tat <= 0)) throw new Error('TAT hours must be a positive number');
  if (b.telegramBotToken) {
    const tok = String(b.telegramBotToken).trim();
    if (!/^\d+:[A-Za-z0-9_-]{20,}$/.test(tok)) throw new Error('That does not look like a Telegram bot token');
    PropertiesService.getScriptProperties().setProperty('TELEGRAM_BOT_TOKEN', tok);
    CacheService.getScriptCache().remove('BOT_INFO');
    try { botInfo_(); } catch (e) { throw new Error('Telegram rejected the bot token: ' + e.message); }
  }
  if (b.clearBotToken) PropertiesService.getScriptProperties().deleteProperty('TELEGRAM_BOT_TOKEN');
  audit_('', u.userId, 'SAVE_SETTINGS', b.telegramBotToken ? 'bot token updated' : '');
  return {};
}

// ============================ NOTIFICATIONS ===========================
const yes_ = (v) => String(v).trim().toLowerCase() === 'yes';
const esc_ = (s) => String(s === undefined || s === null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

function staffRecipients_(s) {
  const staff = table_('Login').rows.filter((r) => isActive_(r) && STAFF.indexOf(normRole_(r['Role'])) >= 0);
  const valid = (e) => /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(e);
  const emails = staff.map((r) => String(r['Email'] || '').trim())
    .concat(String(s.extraEmails || '').split(/[,;\s]+/)).map((e) => e.trim()).filter(valid);
  const chats = staff.map((r) => String(r['Telegram Chat ID'] || '').trim()).concat([String(s.telegramGroupChatId || '').trim()]).filter(Boolean);
  return { emails: uniq_(emails.map((e) => e.toLowerCase())), chats: uniq_(chats) };
}

// Sends to every active Admin/Reviewer on the enabled channels.
function notifyStaff_(subject, html, text) {
  const s = settings_();
  const to = staffRecipients_(s);
  const sent = { email: 0, telegram: 0 };
  if (yes_(s.notifyEmail) && to.emails.length) {
    try {
      MailApp.sendEmail({ to: to.emails.join(','), subject: subject, htmlBody: emailWrap_(s, html), name: s.firmName + ' — CPV' });
      sent.email = to.emails.length;
    } catch (err) { audit_('', 'system', 'EMAIL_ERROR', String(err)); }
  }
  if (yes_(s.notifyTelegram) && botToken_()) {
    to.chats.forEach((id) => { try { tgSend_(id, text); sent.telegram++; } catch (err) { audit_('', 'system', 'TELEGRAM_ERROR', id + ': ' + err); } });
  }
  return sent;
}

function emailWrap_(s, inner) {
  return '<div style="font-family:Segoe UI,Arial,sans-serif;max-width:640px;border:1px solid #c7d2fe;border-radius:10px;overflow:hidden">'
    + '<div style="background:#4f46e5;color:#fff;padding:12px 16px"><b style="font-size:16px">' + esc_(s.firmName) + '</b><br><span style="font-size:12px;opacity:.85">FI / CPV Verification</span></div>'
    + '<div style="padding:16px;font-size:14px;color:#111827">' + inner + '</div>'
    + '<div style="padding:8px 16px;background:#eef2ff;font-size:11px;color:#6b7280">Automatic alert from JL Verify. Manage alerts in Settings &amp; Alerts.</div></div>';
}

function caseLink_(s, caseNo) {
  return s.appUrl ? String(s.appUrl).replace(/\/$/, '') + '/cases/' + encodeURIComponent(caseNo) : '';
}

function fmtIst_(iso) {
  if (!iso) return '';
  const d = new Date(iso);
  return isNaN(d) ? String(iso) : Utilities.formatDate(d, TZ, 'dd/MM/yyyy hh:mm a');
}

function hoursSince_(iso) {
  const d = new Date(iso);
  return isNaN(d) ? 0 : (Date.now() - d.getTime()) / 36e5;
}

function fmtHours_(h) {
  h = Math.max(0, h);
  return h < 48 ? Math.floor(h) + 'h ' + Math.round((h % 1) * 60) + 'm' : Math.floor(h / 24) + 'd ' + Math.floor(h % 24) + 'h';
}

function notifySubmitted_(c) {
  const s = settings_();
  if (!yes_(s.notifyOnSubmit)) return;
  const link = caseLink_(s, c['Case No']);
  const tat = fmtHours_(hoursSince_(c['Allocated At']));
  const rows = [
    ['Case No', c['Case No']], ['Applicant', c['Applicant Name']], ['Client / Branch', c.Client + (c.Branch ? ' / ' + c.Branch : '')],
    ['Product', c.Product + ' · ' + c.Activity], ['Verifications', c['Verifications Required']],
    ['Field Executive', c['Executive Name']], ['Allocated', fmtIst_(c['Allocated At'])], ['Submitted', fmtIst_(c['Submitted At'])], ['Time taken', tat],
  ];
  const html = '<p>A case has been <b>submitted</b> from the field and is ready for review.</p><table style="border-collapse:collapse;font-size:13px">'
    + rows.map((r) => '<tr><td style="padding:4px 12px 4px 0;color:#6b7280">' + esc_(r[0]) + '</td><td style="padding:4px 0"><b>' + esc_(r[1]) + '</b></td></tr>').join('')
    + '</table>' + (link ? '<p><a href="' + esc_(link) + '" style="background:#4f46e5;color:#fff;padding:8px 14px;border-radius:6px;text-decoration:none">Open case</a></p>' : '');
  const text = '📋 <b>Case submitted for review</b>\n'
    + '<b>' + esc_(c['Case No']) + '</b> · ' + esc_(c['Applicant Name']) + '\n'
    + '🏦 ' + esc_(c.Client) + (c.Branch ? ' / ' + esc_(c.Branch) : '') + ' · ' + esc_(c.Product) + ' (' + esc_(c.Activity) + ')\n'
    + '🔎 ' + esc_(c['Verifications Required']) + '\n'
    + '👤 ' + esc_(c['Executive Name']) + ' · ⏱ ' + tat + ' since allocation'
    + (link ? '\n<a href="' + esc_(link) + '">Open case</a>' : '');
  notifyStaff_('Case submitted: ' + c['Case No'] + ' — ' + c['Applicant Name'], html, text);
}

// Time-driven trigger target (installed from Settings → Activate daily alert).
function dailyOverdueAlert() { dailyOverdueAlert_(false); }

function dailyOverdueAlert_(manual) {
  const s = settings_();
  if (!manual && !yes_(s.notifyDailyOverdue)) return { sent: false, count: 0 };
  const limit = Number(s.tatHours) || 24;
  const list = casesLite_()
    .filter((c) => ['APPROVED', 'REPORT_SENT'].indexOf(c.Status) < 0 && c['Allocated At'] && hoursSince_(c['Allocated At']) > limit)
    .sort((a, b) => hoursSince_(b['Allocated At']) - hoursSince_(a['Allocated At']));
  if (!list.length) return { sent: false, count: 0 };

  const byStatus = {};
  list.forEach((c) => { byStatus[c.Status] = (byStatus[c.Status] || 0) + 1; });
  const summary = Object.keys(byStatus).map((k) => k.replace('_', ' ') + ': ' + byStatus[k]).join(' · ');
  const html = '<p><b style="color:#dc2626">' + list.length + ' case(s)</b> are past the ' + limit + '-hour TAT.</p><p style="font-size:12px;color:#6b7280">' + esc_(summary) + '</p>'
    + '<table style="border-collapse:collapse;font-size:12px;width:100%"><tr style="background:#eef2ff"><th align="left" style="padding:5px">Case</th><th align="left" style="padding:5px">Applicant</th><th align="left" style="padding:5px">Executive</th><th align="left" style="padding:5px">Status</th><th align="right" style="padding:5px">Age</th></tr>'
    + list.slice(0, 100).map((c) => '<tr style="border-top:1px solid #e5e7eb"><td style="padding:5px">' + esc_(c['Case No']) + '</td><td style="padding:5px">' + esc_(c['Applicant Name']) + '</td><td style="padding:5px">' + esc_(c['Executive Name']) + '</td><td style="padding:5px">' + esc_(c.Status) + '</td><td align="right" style="padding:5px;color:#dc2626"><b>' + fmtHours_(hoursSince_(c['Allocated At'])) + '</b></td></tr>').join('')
    + '</table>' + (s.appUrl ? '<p><a href="' + esc_(String(s.appUrl).replace(/\/$/, '') + '/dashboard') + '">Open dashboard</a></p>' : '');
  const text = '⏰ <b>TAT overdue: ' + list.length + ' case(s)</b> (&gt; ' + limit + 'h)\n' + esc_(summary) + '\n\n'
    + list.slice(0, 20).map((c) => '• <b>' + esc_(c['Case No']) + '</b> ' + esc_(c['Applicant Name']) + ' — ' + esc_(c['Executive Name']) + ' — ' + fmtHours_(hoursSince_(c['Allocated At']))).join('\n')
    + (list.length > 20 ? '\n…and ' + (list.length - 20) + ' more' : '');
  notifyStaff_('TAT overdue: ' + list.length + ' case(s) — ' + Utilities.formatDate(new Date(), TZ, 'dd/MM/yyyy'), html, text);
  return { sent: true, count: list.length };
}

function testNotification_(b, u) {
  const s = settings_();
  const to = staffRecipients_(s);
  if (b.channel === 'email') {
    const me = String(u.email || '').trim();
    const list = uniq_((me ? [me] : []).concat(to.emails));
    if (!list.length) throw new Error('No email addresses. Add an Email to your user (or Extra email recipients).');
    MailApp.sendEmail({ to: list.join(','), subject: 'Test alert — ' + s.firmName + ' CPV', htmlBody: emailWrap_(s, '<p>✅ Email alerts are working. Sent by ' + esc_(u.name) + '.</p>'), name: s.firmName + ' — CPV' });
    return { sentTo: list.join(', ') };
  }
  if (!botToken_()) throw new Error('Save a Telegram bot token first');
  if (!to.chats.length) throw new Error('No Telegram chats yet. Ask Admins/Reviewers to Connect Telegram from My Profile, or set an office group chat ID.');
  let n = 0;
  to.chats.forEach((id) => { tgSend_(id, '✅ <b>Telegram alerts are working.</b>\nTest sent by ' + esc_(u.name) + '.'); n++; });
  return { sentTo: n };
}

// --- Telegram ---
function tgApi_(method, payload) {
  const token = botToken_();
  if (!token) throw new Error('Telegram bot token not set');
  const res = UrlFetchApp.fetch('https://api.telegram.org/bot' + token + '/' + method, {
    method: 'post', contentType: 'application/json', payload: JSON.stringify(payload || {}), muteHttpExceptions: true,
  });
  const data = JSON.parse(res.getContentText() || '{}');
  if (!data.ok) throw new Error(data.description || ('Telegram error ' + res.getResponseCode()));
  return data.result;
}

function tgSend_(chatId, html) {
  return tgApi_('sendMessage', { chat_id: chatId, text: html, parse_mode: 'HTML', disable_web_page_preview: true });
}

function botInfo_() {
  const cache = CacheService.getScriptCache();
  const hit = cache.get('BOT_INFO');
  if (hit) return JSON.parse(hit);
  const me = tgApi_('getMe');
  cache.put('BOT_INFO', JSON.stringify(me), 21600);
  return me;
}

function telegramLinkStart_(b, u) {
  if (!botToken_()) throw new Error('Telegram is not set up yet. Ask the admin to add a bot token in Settings & Alerts.');
  const code = 'L' + Utilities.getUuid().replace(/-/g, '').slice(0, 10);
  CacheService.getScriptCache().put('TL:' + code, u.userId, 1800);
  const username = botInfo_().username;
  return { code: code, botUsername: username, link: 'https://t.me/' + username + '?start=' + code };
}

function telegramLinkVerify_(b, u) {
  const code = String(b.code || '');
  const owner = CacheService.getScriptCache().get('TL:' + code);
  if (!owner || owner.toLowerCase() !== u.userId.toLowerCase()) throw new Error('Link code expired. Click Connect Telegram again.');
  const updates = tgApi_('getUpdates', { limit: 100, allowed_updates: ['message'] }) || [];
  const hit = updates.filter((x) => x.message && x.message.chat && String(x.message.text || '').trim() === '/start ' + code).pop();
  if (!hit) throw new Error("Not received yet — tap Start in the bot (or send /start " + code + '), then verify again.');
  const chatId = String(hit.message.chat.id);
  withLock_(() => {
    const t = table_('Login');
    writeRow_(t, findUserRow_(t, u.userId), { 'Telegram Chat ID': chatId });
  });
  CacheService.getScriptCache().remove('TL:' + code);
  tgSend_(chatId, '✅ Hi ' + esc_(u.name) + ', you will now receive JL Verify alerts here.');
  audit_('', u.userId, 'TELEGRAM_LINKED', '');
  return { chatId: chatId };
}

function telegramDetectChats_() {
  const updates = tgApi_('getUpdates', { limit: 100 }) || [];
  const seen = {};
  updates.forEach((x) => {
    const m = x.message || x.channel_post || x.my_chat_member;
    const ch = m && m.chat;
    if (!ch) return;
    seen[ch.id] = { id: ch.id, type: ch.type, name: ch.title || [ch.first_name, ch.last_name].filter(Boolean).join(' ') || ch.username || String(ch.id) };
  });
  return { chats: Object.keys(seen).map((k) => seen[k]) };
}

function installTriggers_(b, u) {
  ScriptApp.getProjectTriggers().forEach((t) => { if (t.getHandlerFunction() === 'dailyOverdueAlert') ScriptApp.deleteTrigger(t); });
  const hour = Math.min(23, Math.max(0, Number(settings_().alertHour) || 10));
  ScriptApp.newTrigger('dailyOverdueAlert').timeBased().atHour(hour).everyDays(1).inTimezone(TZ).create();
  audit_('', u.userId, 'INSTALL_TRIGGER', 'daily ' + hour + ':00');
  return { hourLabel: ((hour + 11) % 12 + 1) + ':00 ' + (hour < 12 ? 'AM' : 'PM') };
}

// ============================ AUDIT ===================================
function audit_(caseNo, userId, action, details) {
  try {
    const sh = ss_().getSheetByName('Audit');
    if (sh) sh.appendRow([new Date().toISOString(), String(caseNo || ''), String(userId || ''), action, String(details || '').slice(0, 500)]);
  } catch (e) { /* never block the main action */ }
}

function listAudit_(b) {
  const sh = sheet_('Audit');
  const last = sh.getLastRow();
  if (last < 2) return { rows: [] };
  const n = Math.min(500, last - 1);
  const headers = headers_(sh);
  const rows = sh.getRange(last - n + 1, 1, n, headers.length).getValues().reverse().map((r) => {
    const o = {};
    headers.forEach((h, i) => { o[h] = cell_(r[i]); });
    return o;
  });
  return { rows: b.caseNo ? rows.filter((r) => r['Case No'] === b.caseNo) : rows };
}

// ============================ SHEET HELPERS ===========================
function ss_() { return SPREADSHEET_ID ? SpreadsheetApp.openById(SPREADSHEET_ID) : SpreadsheetApp.getActiveSpreadsheet(); }
function sheet_(name) {
  const sh = ss_().getSheetByName(name);
  if (!sh) throw new Error('Sheet "' + name + '" not found — run setup() in Apps Script');
  return sh;
}
function headers_(sh) { return sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(String); }
function cell_(v) { return v instanceof Date ? v.toISOString() : v; }

function table_(name) {
  const sh = sheet_(name);
  const values = sh.getDataRange().getValues();
  const headers = (values[0] || []).map(String);
  const rows = [];
  for (let i = 1; i < values.length; i++) {
    if (values[i].every((c) => c === '' || c === null)) continue;
    const o = { _row: i + 1 };
    headers.forEach((h, c) => { o[h] = cell_(values[i][c]); });
    rows.push(o);
  }
  return { sh: sh, headers: headers, rows: rows };
}

function rowArray_(headers, obj) {
  return headers.map((h) => {
    const v = obj[h];
    if (v === undefined || v === null) return '';
    return typeof v === 'object' ? JSON.stringify(v) : v;
  });
}

function append_(name, obj) {
  const sh = sheet_(name);
  const headers = headers_(sh);
  const r = sh.getLastRow() + 1;
  sh.getRange(r, 1, 1, headers.length).setNumberFormat('@').setValues([rowArray_(headers, obj)]);
}

function writeRow_(t, row, patch) {
  const merged = Object.assign({}, row, patch);
  t.sh.getRange(row._row, 1, 1, t.headers.length).setValues([rowArray_(t.headers, merged)]);
  Object.assign(row, patch);
}

function strip_(row) {
  const o = Object.assign({}, row);
  delete o._row;
  delete o.Password;
  return o;
}

function nextId_(existing, prefix) {
  let max = 0;
  existing.forEach((v) => { const m = String(v).match(/(\d+)\s*$/); if (m) max = Math.max(max, parseInt(m[1], 10)); });
  return prefix + ('0000' + (max + 1)).slice(-4);
}

function uniq_(arr) { return arr.filter((x, i) => x && arr.indexOf(x) === i); }

function withLock_(fn) {
  const lock = LockService.getScriptLock();
  lock.waitLock(25000);
  try { return fn(); } finally { lock.releaseLock(); }
}

function nowText_() { return Utilities.formatDate(new Date(), TZ, 'dd/MM/yyyy hh:mm:ss a'); }

function checkToken_(token) {
  if (!API_TOKEN || API_TOKEN === 'CHANGE_ME_TO_A_LONG_RANDOM_STRING') return true; // setup mode
  return String(token) === API_TOKEN;
}

function hashPassword_(plain) {
  const raw = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, 'sheetapp::' + plain);
  return 'sha256:' + raw.map((b) => ('0' + (b & 0xff).toString(16)).slice(-2)).join('');
}
function verifyPassword_(stored, provided) {
  if (stored.indexOf('sha256:') === 0) return stored === hashPassword_(provided);
  return stored !== '' && stored === provided; // legacy plaintext (upgraded on next login)
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

// ============================ SETUP ===================================
/**
 * Run ONCE from the Apps Script editor (select "setup" → Run).
 * Safe to run again: it only adds missing tabs / columns / settings.
 * It also asks for every permission the app needs (Sheets, Drive,
 * Gmail send, external requests for Telegram, triggers) in one go.
 */
function setup() {
  const ss = ss_();
  Object.keys(SCHEMA).forEach((name) => {
    let sh = ss.getSheetByName(name);
    if (!sh) sh = ss.insertSheet(name);
    const want = SCHEMA[name];
    if (sh.getLastRow() === 0) {
      sh.getRange(1, 1, 1, want.length).setValues([want]);
    } else {
      const have = headers_(sh);
      want.forEach((h) => { if (have.indexOf(h) < 0) { sh.getRange(1, have.length + 1).setValue(h); have.push(h); } });
    }
    const width = sh.getLastColumn();
    sh.getRange(1, 1, 1, width).setFontWeight('bold').setBackground('#e0e7ff');
    sh.setFrozenRows(1);
    sh.getRange(2, 1, Math.max(1, sh.getMaxRows() - 1), width).setNumberFormat('@'); // keep mobiles / JSON as text
  });

  const login = table_('Login');
  if (!login.rows.some((r) => normRole_(r['Role']) === 'ADMIN')) {
    append_('Login', {
      Timestamp: nowText_(), 'Serial No': login.rows.length + 1, 'Full Name': 'Administrator', Designation: 'Admin',
      'User ID': 'admin', Password: hashPassword_('admin123'), Role: 'ADMIN', Active: 'Yes',
    });
  }
  const s = settings_();
  const sh = sheet_('Settings');
  const existing = sh.getLastRow() >= 2 ? sh.getRange(2, 1, sh.getLastRow() - 1, 1).getValues().map((r) => r[0]) : [];
  Object.keys(DEFAULT_SETTINGS).forEach((k) => { if (existing.indexOf(k) < 0) sh.appendRow([k, s[k]]); });

  const blank = ss.getSheetByName('Sheet1');
  if (blank && blank.getLastRow() === 0 && ss.getSheets().length > 1) ss.deleteSheet(blank);

  // Touch every service once so all permissions are granted now.
  DriveApp.getRootFolder();
  MailApp.getRemainingDailyQuota();
  ScriptApp.getProjectTriggers();
  try { UrlFetchApp.fetch('https://api.telegram.org', { muteHttpExceptions: true }); } catch (e) { /* ignore */ }

  Logger.log('✅ Setup complete. Default admin → admin / admin123 (change it after first login).');
  Logger.log('API_TOKEN is ' + (API_TOKEN === 'CHANGE_ME_TO_A_LONG_RANDOM_STRING' ? 'NOT SET (setup mode — set it before going live!)' : 'set.'));
}

/** Emergency: reset the admin password to admin123 (run from the editor). */
function resetAdminPassword() {
  const t = table_('Login');
  const r = findUserRow_(t, 'admin');
  if (!r) throw new Error('No user with ID "admin"');
  writeRow_(t, r, { Password: hashPassword_('admin123'), Active: 'Yes', Role: 'ADMIN' });
  Logger.log('admin password reset to admin123');
}

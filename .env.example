# Copy this file to .env (Vite only reads .env) and restart the dev server.

# Apps Script Web App URL (Deploy → Web app, Execute as: Me, Who has access: Anyone)
VITE_APPSCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXX/exec

# Shared secret — MUST be exactly the same as API_TOKEN at the top of Code.gs.
# Use a long random string (e.g. from https://www.uuidgenerator.net/ — two UUIDs joined).
VITE_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
